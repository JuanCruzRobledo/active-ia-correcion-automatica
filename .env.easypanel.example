# ============================================
# Active-IA - Variables de Entorno (Easypanel)
# ============================================
# IMPORTANTE: Copiar a .env y configurar valores reales
# ============================================

# ==========================================
# PostgreSQL
# ==========================================
POSTGRES_DB=active_ia_db
POSTGRES_USER=active_ia_user
POSTGRES_PASSWORD=CAMBIAR_CONTRASEÑA_POSTGRES_AQUI

# ==========================================
# Backend - Seguridad (OBLIGATORIO)
# ==========================================
# Generar con: openssl rand -hex 32
SECRET_KEY=CAMBIAR_SECRET_KEY_AQUI

# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CAMBIAR_ENCRYPTION_KEY_AQUI

# ==========================================
# CORS
# ==========================================
# Configurar con tu dominio de Easypanel
# Ejemplo: ["https://tu-proyecto.easypanel.host"]
CORS_ORIGINS=["*"]

# ==========================================
# Frontend
# ==========================================
# URL relativa (Easypanel maneja el routing)
VITE_API_URL=/api/v1

# ==========================================
# Opcional
# ==========================================
ACCESS_TOKEN_EXPIRE_DAYS=7
MAX_UPLOAD_SIZE=104857600
ALLOWED_EXTENSIONS=[".zip",".txt"]
