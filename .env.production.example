# ============================================
# Active-IA - Variables de Entorno (Producción)
# ============================================
# IMPORTANTE: Copiar a .env.production y configurar valores reales
# Uso: cp .env.production.example .env.production
# ============================================

# ==========================================
# PostgreSQL
# ==========================================
POSTGRES_DB=active_ia_db
POSTGRES_USER=active_ia_user
POSTGRES_PASSWORD=CAMBIAR_CONTRASEÑA_SEGURA_AQUI

# ==========================================
# Backend
# ==========================================
# Generar con: openssl rand -hex 32
SECRET_KEY=CAMBIAR_SECRET_KEY_AQUI_32_CARACTERES

# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CAMBIAR_ENCRYPTION_KEY_AQUI_44_CARACTERES

# Días de expiración del token
ACCESS_TOKEN_EXPIRE_DAYS=7

# CORS - Reemplazar con tu dominio
CORS_ORIGINS=["https://tudominio.com","https://www.tudominio.com"]

# Tamaño máximo de archivos (100MB)
MAX_UPLOAD_SIZE=104857600

# Extensiones permitidas
ALLOWED_EXTENSIONS=[".zip",".txt"]

# ==========================================
# Frontend
# ==========================================
# URL del API - Reemplazar con tu dominio
VITE_API_URL=https://tudominio.com/api/v1

# ==========================================
# N8N
# ==========================================
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CAMBIAR_CONTRASEÑA_N8N_AQUI

# URL de webhooks - Reemplazar con tu dominio
WEBHOOK_URL=https://tudominio.com/n8n

# ==========================================
# Nginx
# ==========================================
# Dominio principal
DOMAIN=tudominio.com
