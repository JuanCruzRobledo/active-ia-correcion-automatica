# Variables de Entorno para N8N - Active-IA
# Copiar a .env y ajustar valores

# ========================================
# AUTENTICACIÓN UI DE N8N
# ========================================
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ========================================
# CONFIGURACIÓN DE RED
# ========================================
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http

# URL base para webhooks (usar hostname del contenedor en Docker)
WEBHOOK_URL=http://n8n:5678

# ========================================
# ZONA HORARIA
# ========================================
GENERIC_TIMEZONE=America/Argentina/Buenos_Aires

# ========================================
# GESTIÓN DE EJECUCIONES
# ========================================
# Eliminar ejecuciones antiguas automáticamente
EXECUTIONS_DATA_PRUNE=true

# Días de retención de ejecuciones (168 = 7 días)
EXECUTIONS_DATA_MAX_AGE=168

# ========================================
# LOGGING (Opcional)
# ========================================
# N8N_LOG_LEVEL=info
# N8N_LOG_OUTPUT=console

# ========================================
# NOTAS DE SEGURIDAD
# ========================================
# - NUNCA commitear este archivo con contraseñas reales
# - En producción, usar contraseñas fuertes
# - N8N solo debe ser accesible desde la red interna Docker
# - Las API Keys de Gemini las proporcionan los usuarios en el backend
