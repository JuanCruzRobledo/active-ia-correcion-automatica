# Active-IA Backend - Variables de Entorno
# Copiar a .env y configurar valores reales
# NUNCA commitear el archivo .env con valores reales

# =========================================
# Aplicación
# =========================================
APP_NAME=Active-IA
APP_VERSION=1.0.0
# En desarrollo local: DEBUG=true. Con DEBUG=false (produccion) la app NO
# arranca si SECRET_KEY o ENCRYPTION_KEY conservan su valor placeholder.
DEBUG=false

# =========================================
# Base de datos PostgreSQL
# =========================================
# Formato: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://activeai:password@localhost:5432/activeai

# Pool de conexiones
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# =========================================
# Seguridad - JWT
# =========================================
# Generar con: openssl rand -hex 32
# Obligatorio en produccion (DEBUG=false): dejar el placeholder aborta el arranque.
SECRET_KEY=change-me-in-production

# Algoritmo de firma JWT
ALGORITHM=HS256

# Días de expiración del token
ACCESS_TOKEN_EXPIRE_DAYS=7

# =========================================
# Seguridad - Encriptación API Keys
# =========================================
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Obligatorio en produccion (DEBUG=false): dejar el placeholder aborta el arranque.
ENCRYPTION_KEY=change-me-in-production

# =========================================
# Seguridad - Bloqueo de cuenta
# =========================================
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# =========================================
# Seguridad - Contraseñas
# =========================================
PASSWORD_MIN_LENGTH=8

# =========================================
# Corrección con IA (llamada directa, sin N8N)
# =========================================
# El tutor elige su proveedor (correction_provider = "gemini" | "openrouter")
# y guarda su propia API key encriptada. El backend le pega DIRECTO al proveedor.
#
# Gemini Studio (Google): modelo usado por TODAS las correcciones y la
# generación de rúbricas. Es la única fuente de verdad del nombre del modelo
# (la validación de la key usa este mismo modelo).
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=90
#
# OpenRouter (proveedor alternativo). La API key del usuario es de OpenRouter
# (sk-or-v1-...) y se usa con auth Bearer.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.5-flash

# =========================================
# Archivos
# =========================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=104857600
# Extensiones permitidas para la entrega (separar con coma)
ALLOWED_EXTENSIONS=.zip,.txt
# Anti ZIP-bomb: tope de tamaño descomprimido acumulado y de cantidad de entradas.
MAX_ZIP_EXPANDED_SIZE=104857600
MAX_ZIP_ENTRIES=5000

# =========================================
# CORS
# =========================================
# Separar múltiples orígenes con coma
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =========================================
# Logging
# =========================================
# Niveles: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =========================================
# Rate Limiting
# =========================================
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_API_REQUESTS=100
RATE_LIMIT_API_WINDOW_SECONDS=60
RATE_LIMIT_CORRECCION_REQUESTS=20
RATE_LIMIT_CORRECCION_WINDOW_SECONDS=60

# =========================================
# Eliminación
# =========================================
# Si es true, los endpoints de DELETE eliminan físicamente de la DB (hard delete)
# con cascada completa (comisiones, rúbricas, entregas, correcciones, archivos).
# Si es false (default), se usa baja lógica (soft delete, activo=False).
# NUNCA poner true en producción con datos reales a no ser que sea intencional.

# =========================================
# Email / Resend (notificaciones de avance)
# =========================================
# API key de Resend. Vacía => el EmailService no envía (modo no configurado).
RESEND_API_KEY=
# Remitente. En SANDBOX (sin dominio verificado) debe ser onboarding@resend.dev.
EMAIL_REMITENTE=onboarding@resend.dev
# Throttle de envío (emails/segundo) para respetar el rate limit de Resend.
EMAIL_RATE_POR_SEGUNDO=8.0
