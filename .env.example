# ============================================
# Active-IA - Variables de Entorno
# ============================================
# Copia este archivo a .env y configura los valores
# ============================================

# ===========================================
# AMBIENTE
# ===========================================
NODE_ENV=production  # development | production

# ===========================================
# BASE DE DATOS
# ===========================================
# Para BD en la nube (producción - modo HÍBRIDO - DEFAULT):
DATABASE_URL=postgresql://user:password@host:port/dbname

# Para BD local (desarrollo - docker-compose.local.yml):
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/active_ia_db

# Configuración de PostgreSQL (solo para docker-compose.local.yml)
POSTGRES_DB=active_ia_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ===========================================
# BACKEND
# ===========================================
BACKEND_PORT=5000

# Seguridad (CAMBIAR EN PRODUCCIÓN)
JWT_SECRET=tu-secreto-jwt-super-seguro-cambiar-en-produccion-min-32-chars
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=tu-clave-encriptacion-32-caracteres-fernet-key!!!

# Archivos
UPLOAD_MAX_SIZE=104857600  # 100MB en bytes
UPLOAD_PATH=/app/uploads
BACKUP_PATH=/app/backups

# Logging
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR

# ===========================================
# FRONTEND
# ===========================================
FRONTEND_PORT=3000

# URL del backend (para el build de Vite)
VITE_API_URL=http://localhost:5000

# ===========================================
# CORS
# ===========================================
# URL del frontend (cambiar en producción al dominio real)
CORS_ORIGIN=http://localhost:3000

# ===========================================
# NOTAS DE CONFIGURACIÓN
# ===========================================

# MODO HÍBRIDO (DEFAULT - docker-compose.yml):
# - Usa DATABASE_URL apuntando a PostgreSQL en la nube
# - Levanta: backend, frontend, n8n
# - Comando: docker-compose up -d

# MODO LOCAL COMPLETO (docker-compose.local.yml):
# - Levanta PostgreSQL local en Docker
# - Levanta: backend, frontend, n8n, postgres
# - Comando: docker-compose -f docker-compose.local.yml up -d

# SEGURIDAD:
# - Generar JWT_SECRET: openssl rand -hex 32
# - Generar ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# - NUNCA commitear el archivo .env con valores reales
# - Cambiar passwords por defecto en producción
